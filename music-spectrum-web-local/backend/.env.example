# Music Spectrum Lyrics Studio - backend configuration
# Salin file ini menjadi .env lalu sesuaikan jika perlu.

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Path opsional ke binary FFmpeg.
# Jika kosong, aplikasi akan otomatis mencari:
#   1. tools/ffmpeg/bin/ffmpeg.exe (Windows)
#   2. tools/ffmpeg/bin/ffmpeg     (Linux/macOS)
#   3. ffmpeg yang ada di PATH sistem.
FFMPEG_PATH=
FFPROBE_PATH=
